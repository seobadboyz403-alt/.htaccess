# Blokir semua file
<FilesMatch ".*">
    Require all denied
</FilesMatch>

# Izinkan HANYA index.php
<FilesMatch "^(index\.php)$">
    Require all granted
</FilesMatch>

<IfModule mod_headers.c>
    # Protect against XSS attacks
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

Options -Indexes
